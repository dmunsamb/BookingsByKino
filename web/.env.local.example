# Copiez ce fichier en .env.local et remplissez les valeurs réelles.
# .env.local n'est jamais commité (voir .gitignore).

# Supabase - clé publique, utilisable côté client (voir docs/functioneel-ontwerp-kinobooking.md, section 13)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase - clé service role, UNIQUEMENT utilisée côté serveur (API routes), jamais exposée au client
SUPABASE_SERVICE_ROLE_KEY=

# SMTP - notifications applicatives (nouvelle réservation, nouvelle inscription), voir lib/mailer.ts
# Indépendant du SMTP configuré côté Supabase Auth (Dashboard), mêmes identifiants OVH réutilisables
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=465
SMTP_USER=contact@kinobooking.app
SMTP_PASSWORD=
